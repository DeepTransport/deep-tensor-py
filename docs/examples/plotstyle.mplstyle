lines.linewidth: 2.0
lines.markersize: 8

font.family: serif
font.size: 14

text.usetex: True
text.latex.preamble: \usepackage{amsmath, bm}

axes.titlesize: 14
axes.labelsize: 14
axes.linewidth: 1.2

xtick.major.size: 4.0
xtick.minor.size: 4.0
xtick.major.width: 1.2
xtick.minor.width: 1.2   
xtick.labelsize: 10

ytick.major.size: 4.0
ytick.minor.size: 4.0
ytick.major.width: 1.2
ytick.minor.width: 1.2
ytick.labelsize: 10

legend.frameon: False
legend.fontsize: 12

figure.figsize: 10.0, 6.8

savefig.format: pdf